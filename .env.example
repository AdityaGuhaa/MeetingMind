# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────
# Your Hugging Face token (free account)
# Get it at: https://huggingface.co/settings/tokens
# You must also accept terms for these two models:
#   https://hf.co/pyannote/speaker-diarization-3.1
#   https://hf.co/pyannote/segmentation-3.0
HF_TOKEN=hf_your_token_here

# ── Optional overrides ────────────────────────────────────────────────────
# Ollama URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Model for live near-real-time summaries (needs to be fast)
# LIVE_MODEL=qwen2.5:3b

# Model for post-session deep analysis (can be larger)
# POST_MODEL=qwen2.5:3b
# POST_MODEL=llama3.1:8b   # use this if your LOQ has enough VRAM
